<mujoco model="pick_place_obstacle_wall">
  <!-- Pick/place-around-an-obstacle, WALL variant: a box wall between the tables forces
       the robot to drive the cube AROUND it. Same plan/regions as the ramp variant.
       Layout matches the old isaac-gym repo (tables at y=-1 / y=2.45, obstacle at y=2).
       Collision geoms are primitives only (MJX mesh-collision constraint). -->
  <compiler meshdir="../robot_models/dinova" angle="radian" autolimits="true"/>
  <include file="../robot_models/dinova/dinova_robot.xml"/>

  <statistic center="1.0 0.7 0.3" extent="4.5" meansize="0.05"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.2 0.2 0.2" specular="0 0 0"/>
    <global azimuth="120" elevation="-20"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"/>
  </asset>

  <worldbody>
    <light pos="1 0 2.5" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <geom name="table1" type="box" pos="2 -1 0.10" size="0.2 0.2 0.10" rgba="0.8 0.45 0.2 1"/>
    <geom name="table2" type="box" pos="2 2.45 0.10" size="0.25 0.25 0.10" rgba="0.8 0.55 0.25 1"/>
    <!-- wall between the tables (blocks the direct path); shares the ramp variant's footprint -->
    <geom name="wall" type="box" pos="2 2 0.30" size="1.0 0.2 0.30" rgba="0.5 0.2 0.2 1"/>

    <body name="cube" pos="2 -1 0.22">
      <freejoint/>
      <geom type="box" size="0.02 0.02 0.02" rgba="0.85 0.15 0.15 1" mass="0.1"/>
    </body>
  </worldbody>
</mujoco>
