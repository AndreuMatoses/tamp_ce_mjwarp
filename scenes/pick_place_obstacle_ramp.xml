<mujoco model="pick_place_obstacle_ramp">
  <!-- Pick/place-around-an-obstacle, RAMP variant: the obstacle between the tables is a
       rectangular base prism with a 45 deg wedge on top (the old isaac-gym obstacle_ramp).
       A cube placed near the high edge can SLIDE down onto table2 - a physics-driven
       solution CE can discover. Layout matches the old repo (tables y=-1 / y=2.45, ramp
       at y=2). Built from box primitives only (MJX can't collide meshes), tall side faces
       table1 and slopes down toward table2. -->
  <compiler meshdir="../robot_models/dinova" angle="radian" autolimits="true"/>
  <include file="../robot_models/dinova/dinova_robot.xml"/>

  <statistic center="1.0 0.7 0.3" extent="4.5" meansize="0.05"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.2 0.2 0.2" specular="0 0 0"/>
    <global azimuth="120" elevation="-20"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"/>
  </asset>

  <worldbody>
    <light pos="1 0 2.5" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <geom name="table1" type="box" pos="2 -1 0.10" size="0.2 0.2 0.10" rgba="0.8 0.45 0.2 1"/>
    <geom name="table2" type="box" pos="2 2.45 0.10" size="0.25 0.25 0.10" rgba="0.8 0.55 0.25 1"/>

    <!-- ramp between the tables: base prism (z in [0,0.2]) + 45 deg wedge rising to z=0.6
         on the table1 side (y=-0.2) and sloping down to z=0.2 on the table2 side (y=+0.2).
         The slope box is rotated -45 deg about x so its top face is the hypotenuse and a
         cube on it slides toward +y (table2). -->
    <body name="ramp" pos="2 2 0">
      <geom name="ramp_base" type="box" pos="0 0 0.10" size="1.0 0.20 0.10" rgba="0.14 0.47 0.2 1"/>
      <!-- thin slab (half-thickness 0.04) so the low corner doesn't poke out below/past the
           base; top face kept on the hypotenuse (center = midpoint - t*normal). -->
      <geom name="ramp_slope" type="box" euler="-0.7853982 0 0"
            pos="0 -0.0283 0.3717" size="1.0 0.283 0.04" rgba="0.14 0.47 0.2 1"/>
    </body>

    <body name="cube" pos="2 -1 0.22">
      <freejoint/>
      <geom type="box" size="0.02 0.02 0.02" rgba="0.85 0.15 0.15 1" mass="0.1"/>
    </body>
  </worldbody>
</mujoco>
