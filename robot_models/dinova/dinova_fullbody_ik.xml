<mujoco model="dinova_fullbody_ik">
  <!-- Holonomic planar base (joint_x/y/th) + Kinova Gen3 Lite arm, used by the WHOLE-BODY
       IK solver. Deliberately MINIMAL (like dinova_arm_ik.xml): no gripper fingers, no
       coupled-finger equality, no cameras/chassis collision — only the kinematic chain and
       the pinch_site. The extra structure of the full dinova_robot.xml (equality constraint
       etc.) makes the fused MJX+IK rollout miscompile on the XLA-GPU backend. FK here matches
       the real robot (same base joints + arm mount 0.160 0 0.11 + pinch offset). -->
  <compiler angle="radian" autolimits="true"/>

  <default>
    <default class="body">
      <geom material="body"/>
    </default>
  </default>

  <asset>
    <texture name="body" type="cube" builtin="flat" mark="cross" width="127" height="1278"
      rgb1="0.9 0.9 0.9" rgb2="1 1 1" markrgb="0.8 0.8 0.8" random="0.01"/>
    <material name="body" texture="body" texuniform="true" rgba="0.8 0.8 0.8 1"/>
    <mesh name="BASE" file="kinova/BASE.STL"/>
    <mesh name="SHOULDER" file="kinova/SHOULDER.STL"/>
    <mesh name="ARM" file="kinova/ARM.STL"/>
    <mesh name="FOREARM" file="kinova/FOREARM.STL"/>
    <mesh name="LOWER_WRIST" file="kinova/LOWER_WRIST.STL"/>
    <mesh name="UPPER_WRIST" file="kinova/UPPER_WRIST.STL"/>
    <mesh name="GRIPPER_FRAME" file="kinova/GRIPPER_FRAME.STL"/>
  </asset>

  <worldbody>
    <body name="base_link">
      <joint name="joint_x" type="slide" axis="1 0 0"/>
      <joint name="joint_y" type="slide" axis="0 1 0"/>
      <joint name="joint_th"/>
      <inertial pos="0 0 0.05" mass="50" diaginertia="1 1 1"/>
      <body name="gen3/base_link" pos="0.160 0 0.11" quat="1 0 0 0" childclass="body">
        <geom type="mesh" mesh="BASE"/>
        <body name="SHOULDER" pos="0 0 0.12825">
          <joint name="Kinova_0" pos="0 0 0" axis="0 0 1" range="-2.76 2.76"/>
          <geom type="mesh" mesh="SHOULDER"/>
          <body name="ARM" pos="0 -0.03 0.115" quat="0.707105 0.707108 0 0">
            <joint name="Kinova_1" pos="0 0 0" axis="0 0 1" range="-2.76 2.76"/>
            <geom type="mesh" mesh="ARM"/>
            <body name="FOREARM" pos="0 0.28 0" quat="-3.67321e-06 -1 0 0">
              <joint name="Kinova_2" pos="0 0 0" axis="0 0 1" range="-2.76 2.76"/>
              <geom type="mesh" mesh="FOREARM"/>
              <body name="LOWER_WRIST" pos="0 -0.14 0.02" quat="0.707105 0.707108 0 0">
                <joint name="Kinova_3" pos="0 0 0" axis="0 0 1" range="-2.67 2.67"/>
                <geom type="mesh" mesh="LOWER_WRIST"/>
                <body name="UPPER_WRIST" pos="0.0285 0 0.105" quat="0.707105 0 0.707108 0">
                  <joint name="Kinova_4" pos="0 0 0" axis="0 0 1" range="-2.67 2.67"/>
                  <geom type="mesh" mesh="UPPER_WRIST"/>
                  <body name="GRIPPER_FRAME" pos="-0.105 0 0.0285" quat="0.707105 0 -0.707108 0">
                    <joint name="Kinova_5" pos="0 0 0" axis="0 0 1" range="-2.67 2.67"/>
                    <geom type="mesh" mesh="GRIPPER_FRAME"/>
                    <!-- grasp point at the pad centre (kept in sync with dinova_robot.xml) -->
                    <site name="pinch_site" type="sphere" pos="0 0 0.14" size="0.01" rgba="0 0 1 1"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
